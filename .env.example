APP_NAME=Union Ledger API
ENVIRONMENT=local
DEBUG=true
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://union_ledger:union_ledger@localhost:5432/union_ledger
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]
# Platform operators who review 회장(admin) applications — comma-separated emails.
# Required to approve applications (create 회장/orgs) via /admin-applications.
OPERATOR_EMAILS=operator@konkuk.ac.kr
JWT_SECRET_KEY=change-me-in-env
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
EMAIL_VERIFICATION_CODE_EXPIRE_MINUTES=5
EMAIL_VERIFICATION_VERIFIED_EXPIRE_MINUTES=30
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Union Ledger
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=15

