APP_NAME=Union Ledger API
ENVIRONMENT=production
DEBUG=false
API_V1_PREFIX=/api/v1

# Docker Compose service name (not localhost)
POSTGRES_PASSWORD=change-me-strong-password
DATABASE_URL=postgresql+asyncpg://union_ledger:change-me-strong-password@postgres:5432/union_ledger

ALLOWED_ORIGINS=["https://your-frontend.example.com"]
# Platform operators who review 회장(admin) applications — comma-separated emails.
# REQUIRED: if empty, nobody can approve applications and no 회장 can be created.
OPERATOR_EMAILS=dev1@konkuk.ac.kr,dev2@konkuk.ac.kr,dev3@konkuk.ac.kr
JWT_SECRET_KEY=change-me-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
EMAIL_VERIFICATION_CODE_EXPIRE_MINUTES=5
EMAIL_VERIFICATION_VERIFIED_EXPIRE_MINUTES=30
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Union Ledger
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=15

# --- OCR / receipt extraction ---
# OCR_PROVIDER: "local" = PaddleOCR (default, free, offline) | "clova" = Naver
# CLOVA Receipt OCR (Korean-specialized, structured fields). On any CLOVA error
# we fall back to local OCR (set CLOVA_OCR_FALLBACK_TO_LOCAL=false to disable).
OCR_PROVIDER=local
# Get these from NCP console → CLOVA OCR → your Receipt domain (only for "clova"):
CLOVA_OCR_INVOKE_URL=
CLOVA_OCR_SECRET_KEY=
CLOVA_OCR_TIMEOUT_SECONDS=30
CLOVA_OCR_FALLBACK_TO_LOCAL=true
# Local PaddleOCR passes per image: 0=all (accurate), 3=balanced, 1=fastest.
OCR_MAX_VARIANTS=3
