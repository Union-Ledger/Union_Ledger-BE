APP_NAME=Union Ledger API
ENVIRONMENT=production
DEBUG=false
API_V1_PREFIX=/api/v1

# Docker Compose service name (not localhost)
POSTGRES_PASSWORD=change-me-strong-password
DATABASE_URL=postgresql+asyncpg://union_ledger:change-me-strong-password@postgres:5432/union_ledger

ALLOWED_ORIGINS=["https://your-frontend.example.com"]
JWT_SECRET_KEY=change-me-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
EMAIL_VERIFICATION_CODE_EXPIRE_MINUTES=5
EMAIL_VERIFICATION_VERIFIED_EXPIRE_MINUTES=30
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Union Ledger
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=15
